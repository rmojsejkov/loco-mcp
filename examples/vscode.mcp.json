{
  "inputs": [
    {
      "type": "promptString",
      "id": "loco-api-key",
      "description": "Loco service API key",
      "password": true
    }
  ],
  "servers": {
    "loco": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@rmojsejkov/loco-mcp"],
      "env": {
        "LOCO_API_KEY": "${input:loco-api-key}",
        "LOCO_IMPORT_LOCALE": "de",
        "LOCO_WORKSPACE_ROOT": "${workspaceFolder}"
      }
    }
  }
}
